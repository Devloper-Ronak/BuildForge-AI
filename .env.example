# ==========================================
# BUILDFORGE AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port & URLs
PORT=5001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_here

# Database URL
DATABASE_URL=mongodb://127.0.0.1:27017/buildforgeai
MONGO_URI=mongodb://127.0.0.1:27017/buildforgeai

# Google OAuth 2.0 Credentials
# Get these at https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# SMTP / Email Service Configuration
# 1. Direct Gmail Configuration (16-character App Password from https://myaccount.google.com/apppasswords)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# 2. Or Custom SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=BuildForge AI <noreply@buildforge.ai>

# AI API Keys
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
